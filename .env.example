# Environment example for Protocol 215 local development.
# Copy to .env — never commit secrets.

APP_ENV=local
OBJECT_STORE_BACKEND=local
STATE_STORE_BACKEND=memory
EVENT_BUS_BACKEND=inprocess
GEMINI_BACKEND=fake
GEMINI_MODEL=gemini-3.5-flash

# Live Gemini tests (never enable in CI):
# RUN_LIVE_GEMINI_TESTS=1

# Required when using gcs | firestore | pubsub | vertex backends:
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud adapter config (Prompt 11) — no service-account JSON in env files committed to git:
# OBJECT_STORE_BACKEND=gcs
# STATE_STORE_BACKEND=firestore
# EVENT_BUS_BACKEND=pubsub
# GCS_BUCKET=protocol-215-artifacts
# PUBSUB_TOPIC_RECEIVED=amendment-received
# PUBSUB_TOPIC_RESUME=amendment-resume
# WORKER_REQUIRE_OIDC=true

LOCAL_OBJECT_STORE_PATH=data/object_store
SQLITE_PATH=data/sqlite/protocol215.db

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

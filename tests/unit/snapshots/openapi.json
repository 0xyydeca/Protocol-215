  "paths": {
    "/api/demo/recording-readiness": {
      "get": {
        "description": "Judge-facing recording preflight. Real bounded checks; never mutates state.\nDoes not return secrets.",
        "operationId": "recording_readiness_api_demo_recording_readiness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Recording Readiness"
      }
    },
    "/api/demo/reset": {
      "post": {
        "description": "Clear synthetic demo runs/actions/approvals/manifests.\n\nCloud mode requires confirm=true (or CONFIRM_DEMO_RESET=yes via script).\nDoes not delete fixtures/ source PDFs or GCP infrastructure.",
        "operationId": "demo_reset_api_demo_reset_post",
        "parameters": [
          {
            "in": "query",
            "name": "confirm",
            "required": false,
            "schema": {
              "default": false,
              "title": "Confirm",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoResetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Demo Reset"
      }
    },

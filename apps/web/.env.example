# Optional: public API origin when the UI is hosted separately (e.g. Vercel).
# Leave unset for Cloud Run same-origin SPA and for local `npm run dev` (Vite proxy).
# Changing VITE_API_BASE_URL requires rebuilding the Vite app (Vite inlines at build time).
# Vercel production builds fail if this is missing or not HTTPS.
# VITE_API_BASE_URL=https://YOUR-CLOUD-RUN-WEB.run.app
